# Where the server listens
PORT=3000
HOST=0.0.0.0

# Where the SQLite file lives (defaults to ./data/chakula.db)
DB_FILE=./data/chakula.db

# Session cookies are marked Secure when the request arrives over HTTPS.
# Behind a proxy that terminates TLS, set this to 1 so cookies are always Secure.
# FORCE_SECURE_COOKIE=1
